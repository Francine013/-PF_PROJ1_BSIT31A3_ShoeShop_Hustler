@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@{
    ViewData["Title"] = "Dashboard";
    var userName = HttpContextAccessor.HttpContext?.Session.GetString("UserName") ?? "Admin User";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - ShoeShop Inventory</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet" />

    <style>
        body {
            background: radial-gradient(circle at top, #0a0a0a, #1a1a1a, White);
            font-family: 'Poppins', sans-serif;
            color: #fff;
        }

        .welcome-section {
            text-align: center;
            padding: 70px 20px;
            background: linear-gradient(135deg, rgba(0, 0, 0, 0.9), #111);
            border-radius: 20px;
            margin-bottom: 40px;
            box-shadow: 0 5px 25px rgba(255, 215, 0, 0.15);
        }

            .welcome-section h1 {
                font-size: 2.8rem;
                font-weight: 700;
                color: #f1c40f;
            }

            .welcome-section p {
                color: #ccc;
                font-size: 1.1rem;
            }

        .stat-card {
            border: none;
            border-radius: 20px;
            background: linear-gradient(145deg, #202020, #181818);
            color: #fff;
            text-align: center;
            padding: 25px 15px;
            transition: all 0.3s ease;
        }

            .stat-card:hover {
                transform: translateY(-8px);
                box-shadow: 0 10px 25px rgba(241, 196, 15, 0.3);
            }

        .stat-icon {
            font-size: 3rem;
            margin-bottom: 15px;
            color: #f1c40f;
        }

        .stat-title {
            text-transform: uppercase;
            font-size: 1rem;
            color: #aaa;
        }

        .stat-value {
            font-size: 1.7rem;
            font-weight: 600;
            color: #fff;
        }

        footer {
            margin-top: 50px;
            text-align: center;
            color: #aaa;
        }

        .fade-in {
            animation: fadeIn 1.2s ease-in-out;
        }

        
    </style>
</head>

<body>
    <div class="container-fluid mt-4 fade-in">

   
        <div class="welcome-section">
            <h1><i class="fas fa-tachometer-alt me-2"></i>Welcome back, @userName 👟</h1>
            <p>Your personalized shoe inventory dashboard.</p>
        </div>

        <div class="row g-4 justify-content-center">

            <div class="col-md-3">
                <div class="stat-card">
                    <i class="fas fa-shoe-prints stat-icon"></i>

                </div>
            </div>

            <div class="col-md-3">
                <div class="stat-card">
                    <i class="fas fa-box-open stat-icon"></i>
                </div>
            </div>

            <div class="col-md-3">
                <div class="stat-card">
                    <i class="fas fa-chart-line stat-icon"></i>
                </div>
            </div>

            <div class="col-md-3">
                <div class="stat-card">
                    <i class="fas fa-users stat-icon"></i>
                </div>
            </div>

        </div>

        <footer class="mt-5">
            <p>&copy; @DateTime.Now.Year ShoeShop Inventory — Style meets system.</p>
        </footer>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
