@model ShoeShop.Services.DTOs.CreateShoeDto
@{
    ViewData["Title"] = "Create New Shoe";
}

<div class="container py-5">
    <div class="card shadow-lg rounded-3">
        <div class="card-header bg-primary text-white">
            <h2 class="card-title mb-0"><i class="fas fa-plus-circle"></i> Create New Shoe</h2>
        </div>
        <div class="card-body p-4">

            <form asp-action="Create" method="post" enctype="multipart/form-data">
                <div asp-validation-summary="All" class="text-danger mb-3"></div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Name" class="form-label">Shoe Name <span class="text-danger">*</span></label>
                        <input asp-for="Name" class="form-control" placeholder="e.g. Air Max 90" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Brand" class="form-label">Brand <span class="text-danger">*</span></label>
                        <input asp-for="Brand" class="form-control" placeholder="e.g. Nike" />
                        <span asp-validation-for="Brand" class="text-danger"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-3 mb-3">
                        <label asp-for="Cost" class="form-label">Cost (₱) <span class="text-danger">*</span></label>
                        <input asp-for="Cost" type="number" step="0.01" min="0" class="form-control" placeholder="0.00" />
                        <span asp-validation-for="Cost" class="text-danger"></span>
                    </div>

                    <div class="col-md-3 mb-3">
                        <label asp-for="Price" class="form-label">Price (₱) <span class="text-danger">*</span></label>
                        <input asp-for="Price" type="number" step="0.01" min="0" class="form-control" placeholder="0.00" />
                        <span asp-validation-for="Price" class="text-danger"></span>
                    </div>

                    <div class="col-md-3 mb-3">
                        <label asp-for="StockQuantity" class="form-label">Stock Quantity</label>
                        <input asp-for="StockQuantity" type="number" min="0" class="form-control" placeholder="0" />
                        <span asp-validation-for="StockQuantity" class="text-danger"></span>
                    </div>

                    <div class="col-md-3 mb-3">
                        <label asp-for="size" class="form-label">Size</label>
                        <input asp-for="size" type="number" min="1" max="50" class="form-control" placeholder="e.g. 42" />
                        <span asp-validation-for="size" class="text-danger"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="ColorName" class="form-label">Color Name</label>
                        <input asp-for="ColorName" class="form-control" placeholder="e.g. Black" />
                        <span asp-validation-for="ColorName" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="AvailabilityStatus" class="form-label">Availability Status</label>
                        <select asp-for="AvailabilityStatus" class="form-select">
                            <option value="Available">Available</option>
                            <option value="Not Available">Not Available</option>
                        </select>
                        <span asp-validation-for="AvailabilityStatus" class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label">Description</label>
                    <textarea asp-for="Description" class="form-control" rows="3" placeholder="Enter shoe description..."></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label">Product Image</label>

                    <input asp-for="ImageUrl" type="text" class="form-control mb-2" id="imageUrlInput" placeholder="Paste image URL here (optional)" />

                    <label for="imageFileInput" class="form-label small text-muted">Or upload an image file:</label>
                    <input type="file" id="imageFileInput" name="ImageFile" class="form-control" accept="image/*" />
                    <small class="text-muted">Accepted formats: JPG, PNG, GIF (Max 5MB)</small>

                    <div class="mt-3">
                        <img id="imagePreview" src="#" alt="Image Preview" class="img-thumbnail" style="max-width: 300px; display: none;" />
                    </div>
                </div>

                <div class="form-check mb-4">
                    <input type="checkbox" asp-for="IsActive" class="form-check-input" checked />
                    <label asp-for="IsActive" class="form-check-label">Is Active (Show on website)</label>
                </div>

                <div class="mt-4">
                    <button type="submit" class="btn btn-primary me-2">
                        <i class="fas fa-save"></i> Save Shoe
                    </button>
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="fas fa-list"></i> Back to List
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        const imageUrlInput = document.getElementById('imageUrlInput');
        const imageFileInput = document.getElementById('imageFileInput');
        const imagePreview = document.getElementById('imagePreview');

        imageUrlInput.addEventListener('input', function () {
            const url = this.value.trim();
            if (url) {
                imagePreview.src = url;
                imagePreview.style.display = 'block';
                imageFileInput.value = '';
            } else {
                imagePreview.style.display = 'none';
            }
        });

        imageFileInput.addEventListener('change', function (event) {
            const file = event.target.files[0];
            if (file) {
                if (file.size > 5 * 1024 * 1024) {
                    alert('File size should not exceed 5MB');
                    this.value = '';
                    return;
                }

                const allowedTypes = ['image/jpeg', 'image/png', 'image/gif'];
                if (!allowedTypes.includes(file.type)) {
                    alert('Only JPG, PNG, and GIF images are allowed');
                    this.value = '';
                    return;
                }

                const reader = new FileReader();
                reader.onload = function (e) {
                    imagePreview.src = e.target.result;
                    imagePreview.style.display = 'block';
                    imageUrlInput.value = '';
                };
                reader.readAsDataURL(file);
            }
        });

        window.addEventListener('load', function() {
            if (imageUrlInput.value.trim()) {
                imagePreview.src = imageUrlInput.value;
                imagePreview.style.display = 'block';
            }
        });
    </script>
}