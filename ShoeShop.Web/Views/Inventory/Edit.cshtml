@model ShoeShop.Services.DTOs.CreateShoeDto
@{
    ViewData["Title"] = "Edit Shoe";
    var variationId = ViewBag.VariationId ?? Model.Id;
}

<div class="container py-2">
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-times-circle me-2"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-warning alert-dismissible fade show" role="alert">
            <h5 class="alert-heading"><i class="fas fa-exclamation-triangle"></i> Validation Issues:</h5>
            <ul class="mb-0">
                @foreach (var key in ViewData.ModelState.Keys)
                {
                    var state = ViewData.ModelState[key];
                    if (state.Errors.Any())
                    {
                        foreach (var error in state.Errors)
                        {
                            <li><strong>@key:</strong> @error.ErrorMessage</li>
                        }
                    }
                }
            </ul>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
</div>

<div class="container py-3">
    <div class="card shadow-lg rounded-3">
        <div class="card-header bg-warning text-dark">
            <h2 class="card-title mb-0">
                <i class="fas fa-edit"></i> Edit Shoe: @Model.Name
            </h2>
        </div>

        <div class="card-body p-4">
            <form asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                
                <input asp-for="Id" type="hidden" />
                <input type="hidden" name="ShoeColorVariationId" value="@variationId" />

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Name" class="form-label">Shoe Name <span class="text-danger">*</span></label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Brand" class="form-label">Brand <span class="text-danger">*</span></label>
                        <input asp-for="Brand" class="form-control" />
                        <span asp-validation-for="Brand" class="text-danger"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-3 mb-3">
                        <label asp-for="Cost" class="form-label">Cost (₱) <span class="text-danger">*</span></label>
                        <input asp-for="Cost" type="number" step="0.01" min="0" class="form-control" />
                        <span asp-validation-for="Cost" class="text-danger"></span>
                    </div>

                    <div class="col-md-3 mb-3">
                        <label asp-for="Price" class="form-label">Price (₱) <span class="text-danger">*</span></label>
                        <input asp-for="Price" type="number" step="0.01" min="0" class="form-control" />
                        <span asp-validation-for="Price" class="text-danger"></span>
                    </div>

                    <div class="col-md-3 mb-3">
                        <label asp-for="StockQuantity" class="form-label">Stock Quantity</label>
                        <input asp-for="StockQuantity" type="number" min="0" class="form-control" />
                        <span asp-validation-for="StockQuantity" class="text-danger"></span>
                    </div>

                    <div class="col-md-3 mb-3">
                        <label asp-for="size" class="form-label">Size</label>
                        <input asp-for="size" type="number" min="1" max="50" class="form-control" />
                        <span asp-validation-for="size" class="text-danger"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="ColorName" class="form-label">Color Name</label>
                        <input asp-for="ColorName" class="form-control" />
                        <span asp-validation-for="ColorName" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="AvailabilityStatus" class="form-label">Availability Status</label>
                        <select asp-for="AvailabilityStatus" class="form-select">
                            <option value="Available">Available</option>
                            <option value="Not Available">Not Available</option>
                        </select>
                        <span asp-validation-for="AvailabilityStatus" class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label">Description</label>
                    <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <div class="mb-3">

                    @if (!string.IsNullOrEmpty(Model.ImageUrl))
                    {
                        <div class="mb-2">
                            <img src="@Model.ImageUrl" alt="Current Image"
                                 class="img-thumbnail" style="max-width: 200px;"
                                 onerror="this.onerror=null;this.src='https://placehold.co/200x200?text=No+Image';" />
                        </div>
                    }

                    <input asp-for="ImageUrl" type="hidden" />

                    <label for="ImageFile" class="form-label">Upload New Image (optional)</label>
                    <input type="file" id="ImageFile" name="ImageFile" class="form-control" accept="image/*" />
                    <small class="text-muted">Leave empty to keep current image. Accepted: JPG, PNG, GIF (Max 5MB)</small>

                    <div class="mt-3">
                        <img id="newImagePreview" src="#" alt="New Image Preview"
                             class="img-thumbnail" style="max-width: 200px; display: none;" />
                    </div>
                </div>

                <div class="form-check mb-4">
                    <input type="checkbox" asp-for="IsActive" class="form-check-input" />
                    <label asp-for="IsActive" class="form-check-label">Is Active (Show on website)</label>
                </div>

                <div class="mt-4">
                    <button type="submit" class="btn btn-warning me-2 text-dark">
                        <i class="fas fa-sync-alt"></i> Update Shoe
                    </button>
                    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-info text-white me-2">
                        <i class="fas fa-info-circle"></i> View Details
                    </a>
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="fas fa-arrow-left"></i> Back to List
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")

    <script>
        const imageFileInput = document.getElementById('ImageFile');
        const newImagePreview = document.getElementById('newImagePreview');

        imageFileInput.addEventListener('change', function (event) {
            const file = event.target.files[0];

            if (file) {
                if (file.size > 5 * 1024 * 1024) {
                    alert('File size should not exceed 5MB');
                    this.value = '';
                    newImagePreview.style.display = 'none';
                    return;
                }
                const allowedTypes = ['image/jpeg', 'image/png', 'image/gif'];
                if (!allowedTypes.includes(file.type)) {
                    alert('Only JPG, PNG, and GIF images are allowed');
                    this.value = '';
                    newImagePreview.style.display = 'none';
                    return;
                }

                const reader = new FileReader();
                reader.onload = function (e) {
                    newImagePreview.src = e.target.result;
                    newImagePreview.style.display = 'block';
                };
                reader.readAsDataURL(file);
            } else {
                newImagePreview.style.display = 'none';
            }
        });
    </script>
}