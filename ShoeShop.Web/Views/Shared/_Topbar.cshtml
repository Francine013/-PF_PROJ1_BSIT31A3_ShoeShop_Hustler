@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@{
    var username = HttpContextAccessor.HttpContext?.Session.GetString("UserName");
}
<nav class="navbar navbar-expand navbar-light bg-light">
    <div class="container-fluid">
        <a class="navbar-brand" href="/">Shoe Inventory</a>
        <div class="d-flex">
            @if (!string.IsNullOrEmpty(username))
            {
                <span class="navbar-text me-3">Hello, @username!</span>
                <a href="/Account/Logout" class="btn btn-outline-danger">Logout</a>
            }
            else
            {
                <a href="/Account/Login" class="btn btn-outline-primary me-2">Login</a>
                <a href="/Account/Register" class="btn btn-outline-success">Create Account</a>
            }
        </div>
    </div>
</nav>
